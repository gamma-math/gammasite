# MobilePay/Vipps environment used only by src/scripts/vipps.
# Copy this file to .env and fill in the credentials locally.

VIPPS_BASE_URL=https://apitest.vipps.no
VIPPS_MSN=
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_OCP_APIM_SUBSCRIPTION_KEY=

# Used by --payment and --create-agreement.
VIPPS_PHONE_NUMBER=
VIPPS_RETURN_URL=https://localhost:5001/pay
VIPPS_MERCHANT_AGREEMENT_URL=https://localhost:5001/account/manage/subscriptions

# Used by --register-webhook when no URL is supplied as a command argument.
VIPPS_WEBHOOK_URL=https://test.gam-ma.dk/api/payments/vipps/webhook
# VIPPS_WEBHOOK_SECRET belongs to GamMaSite's deployment environment, not here.

# Optional values used by the Docker Compose services.
VIPPS_PAYMENT_REFERENCE=
VIPPS_AGREEMENT_ID=
VIPPS_CHARGE_ID=
VIPPS_OLD_WEBHOOK_ID=
