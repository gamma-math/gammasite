# Local-only Docker development settings.
# Compose has matching local defaults. Use this file as a reference or copy
# it to .env when local overrides or integration credentials are needed.

APP_PORT=5000
PUBLIC_BASE_URL=http://localhost:5000
ALLOWED_HOSTS=localhost

# GamMaSite MySQL container.
MYSQL_PORT=3306
MYSQL_DATABASE=gammasite_local
MYSQL_APP_USER=gammasite_app
MYSQL_APP_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-local-root
MYSQL_TZ=Europe/Copenhagen

# Gamma Finance PostgreSQL container.
FINANCE_POSTGRES_PORT=5434
FINANCE_POSTGRES_DB=gamma_finance_local
FINANCE_POSTGRES_ADMIN_PASSWORD=change-me-local-finance-admin
FINANCE_READ_PASSWORD=change-me-local-finance-read
FINANCE_WRITE_PASSWORD=change-me-local-finance-write
FINANCE_POSTGRES_TZ=Europe/Copenhagen

# Optional external integrations. Leave blank for a local database-only run.
MAILGUN_HOST=
MAILGUN_API_KEY=
MAILGUN_MAIL=
SMS_APIGATEWAY_KEY=
STRIPE_PUBLIC_API_KEY=
STRIPE_SECRET_API_KEY=
STRIPE_WEBHOOK_SECRET=
VIPPS_BASE_URL=https://apitest.vipps.no
VIPPS_MSN=
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_OCP_APIM_SUBSCRIPTION_KEY=
VIPPS_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITLAB_TOKEN=
ICAL_HOST_ADDRESS=
