# Stripe API settings used only by src/services/stripe.
# Copy this file to .env and fill in the secret locally.

STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_PUBLIC_API_KEY=
STRIPE_SECRET_API_KEY=

# Optional. Leave empty to use the account's default API version.
STRIPE_API_VERSION=

# Optional default payout ID for --payout-transactions without an argument.
STRIPE_PAYOUT_ID=

