@using Microsoft.AspNetCore.Identity
@inject SignInManager<SiteUser> SignInManager
@inject UserManager<SiteUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <title>@ViewData["Title"] - GamMa</title>
    <!-- JQuery dependencies -->
    <script src="https://code.jquery.com/jquery-3.6.0.slim.min.js" integrity="sha384-Qg00WFl9r0Xr6rUqNLv1ffTSSKEFFCDCKVyHZ+sVt8KuvG99nWw5RNvbhuKgif9z" crossorigin="anonymous"></script>
    <!-- Bootstrap dependencies -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta2/dist/css/bootstrap-select.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta2/dist/js/bootstrap-select.min.js"></script>
    <!-- Sweetalert dependencies -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Datatables dependencies -->
    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.0.1/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.11.4/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/responsive/2.2.9/css/responsive.bootstrap5.min.css">
    <script src="https://cdn.datatables.net/1.11.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.4/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.2.9/js/dataTables.responsive.min.js"></script>
    <!-- Summernote dependencies -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.20/summernote-lite.min.css" rel="stylesheet" integrity="sha512-ZbehZMIlGA8CTIOtdE+M81uj3mrcgyrh6ZFeG33A4FHECakGrOsTPlPQ8ijjLkxgImrdmSVUHn1j+ApjodYZow==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.20/summernote-lite.min.js" integrity="sha512-lVkQNgKabKsM1DA/qbhJRFQU8TuwkLF2vSN3iU/c7+iayKs08Y8GXqfFxxTZr1IcpMovXnf2N/ZZoMgmZep1YQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <!-- Stripe dependencies -->
    <script src="https://js.stripe.com/v3/"></script>
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="legacy-site-header">
        <div class="legacy-page-shell legacy-topbar">
            <a class="legacy-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/lib/logo_blue.png" alt="GamMa-logo" />
            </a>
            <nav class="legacy-topbar-actions" aria-label="Navigation">
                <a class="legacy-header-button" href="/react/events">
                    <span aria-hidden="true">☰</span>
                    Menu
                </a>
                @if (SignInManager.IsSignedIn(User) && (User.IsInRole("Admin") || User.IsInRole("ADMIN") || User.IsInRole("READ_ADMIN")))
                {
                    <a class="legacy-header-button" href="/react/admin/events">Admin</a>
                }
                @if (SignInManager.IsSignedIn(User))
                {
                    <a class="legacy-profile-link" href="/react/account/manage" aria-label="Profil">
                        <svg aria-hidden="true" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="10"></circle>
                            <circle cx="12" cy="10" r="3"></circle>
                            <path d="M7 20.66c1.3-2.05 3.05-3.08 5-3.08s3.7 1.03 5 3.08"></path>
                        </svg>
                    </a>
                }
                else
                {
                    <a class="legacy-header-button" href="/react/account/login">Login</a>
                    <a class="legacy-header-button legacy-header-button-primary" href="/react/account/register">Bliv medlem</a>
                }
            </nav>
        </div>
    </header>
    <div class="legacy-page-shell legacy-main-shell">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="legacy-footer">
        <div class="legacy-page-shell legacy-footer-inner">
            <div>
                <h2>Alumneforeningen GamMa</h2>
                <p>CVR: <a href="https://datacvr.virk.dk/data/visenhed?enhedstype=virksomhed&id=34637768">34637768</a></p>
                <p>Kontakt: <a href="mailto:bestyrelsen@gam-ma.dk">bestyrelsen@gam-ma.dk</a></p>
            </div>
            <div class="legacy-footer-socials">
                <a href="https://www.linkedin.com/company/gamma-math-ucph/" aria-label="LinkedIn">in</a>
                <a href="https://www.facebook.com/share/g/1Exv7epudc/" aria-label="Facebook">f</a>
                <a href="https://www.instagram.com/gamma_ku_2100" aria-label="Instagram">ig</a>
            </div>
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        initializeDatatable();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
