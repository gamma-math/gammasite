@using Stripe;
@model IEnumerable<Product>;

@{
    ViewData["Title"] = "Produkter";
}

@*
    LEGACY MVC VIEW:
    Payment UI has mostly moved to React and Stripe API endpoints. Review this
    file carefully before removal because legacy payment links may still exist.
*@

<h1>Produkter</h1>
<table class="table table-striped table-bordered" id="produkter">
    <thead class="table-dark">
        <tr>
            <th>Navn</th>
            <th>Beskrivelse</th>
            <th>Produkt</th>
        </tr>
    </thead>
    @foreach (Product product in Model)
    {
        <tr>
            <td>@product.Name</td>
            <td>@product.Description</td>
            <td><a class="btn btn-sm btn-primary" asp-action="Product" asp-route-id="@product.Id">Vælg</a></td>
        </tr>
    }
</table>
