@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout))
    {
        Layout = (string)parentLayout;
    }
    else
    {
        Layout = "./_Layout.cshtml";
    }
}

@{
    var hideManageNavigation = ViewData["HideManageNavigation"] as bool? == true;
}

@if (hideManageNavigation)
{
    <div class="legacy-centered-page">
        @RenderBody()
    </div>
}
else
{
    <h2>Administrér din bruger</h2>
    <div class="row">
        <div class="col-md-3">
            <partial name="_ManageNav" />
        </div>
        <div class="col-md-9">
            @RenderBody()
        </div>
    </div>
}

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
