@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Email bekræftet";
}

<section class="legacy-centered-page">
    <article class="legacy-auth-card">
        <div class="legacy-card-hero">
            <p class="legacy-kicker">Profil oprettet</p>
            <h1>Email bekræftet</h1>
            <p>Din mail er bekræftet, og din profil er nu oprettet i GamMas system.</p>
        </div>

        <div class="legacy-card-body legacy-simple-body">
            <p>
                Et bestyrelsesmedlem vil herefter tjekke, om du er berettiget til medlemskab.
                Kontakt gerne <a href="mailto:bestyrelsen@gam-ma.dk?Subject=GamMa-brugeroprettelse" target="_top">bestyrelsen@gam-ma.dk</a>
                for at sætte skub i processen.
            </p>
            <a class="legacy-primary-button" asp-area="Identity" asp-page="/Account/Login">Log ind</a>
        </div>
    </article>
</section>
